DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=moneymentor
DB_PASSWORD=replace_with_your_password
DB_NAME=moneymentor_kenya
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ISSUER=moneymentor-local
JWT_AUDIENCE=moneymentor-api

# For cloud deployment set HOST=0.0.0.0; local default stays loopback.
HOST=127.0.0.1

# Week 10: real producer URL, or local stand-in for rehearsal.
PARTNER_URL=http://127.0.0.1:5100
PARTNER_DEMO=true

# Week 9: generate locally with node setup-api-key.js (or --demo).
# Do not put a real key in this example file or browser code.
API_KEYS=
RATE_LIMIT_MAX=100
# Supplied privately by our producer; different from HandyNear's incoming key.
PARTNER_API_KEY=
# Named private values created by setup-api-key.js; keep real values out of Git.
HANDYNEAR_API_KEY=
MONEYMENTOR_TEST_API_KEY=
